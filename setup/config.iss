; Script generated by the Inno Script Studio Wizard.
; Build with setup\build_all.bat, or directly:  ISCC.exe config.iss /DMyAppVersion=2.6.0
#ifndef MyAppVersion
  #define MyAppVersion "2.6.0"
#endif
#define MyAppName "TrayMonitor"
#define MyAppPublisher "chris-v8"
#define MyAppURL "https://github.com/chris-v8/tray-monitor"
#define AllIcons "BatteryIcon.exe CpuIcon.exe GpuIcon.exe RamIcon.exe DiskIcon.exe NetIcon.exe"

[Setup]
; same AppId as the original release: upgrades an existing installation
AppId={{D337AB36-5DC7-40A5-9127-E0273D006CD6}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
OutputDir=..\bin\Release
OutputBaseFilename=TrayMonitor-Setup-{#MyAppVersion}
SolidCompression=yes
InternalCompressLevel=ultra64
PrivilegesRequired=lowest
; running icons are closed by the [Code] section below
CloseApplications=no
AlwaysShowComponentsList=True
ShowComponentSizes=False
ShowLanguageDialog=no
UninstallDisplayIcon={app}\CpuIcon.exe

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\bin\Release\BatteryIcon.exe"; DestDir: "{app}"; Flags: ignoreversion; Components: icons\battery
Source: "..\bin\Release\DiskIcon.exe"; DestDir: "{app}"; Flags: ignoreversion; Components: icons\disk
Source: "..\bin\Release\NetIcon.exe"; DestDir: "{app}"; Flags: ignoreversion; Components: icons\net
Source: "..\bin\Release\RamIcon.exe"; DestDir: "{app}"; Flags: ignoreversion; Components: icons\ram
Source: "..\bin\Release\CpuIcon.exe"; DestDir: "{app}"; Flags: ignoreversion; Components: icons\cpu
Source: "..\bin\Release\GpuIcon.exe"; DestDir: "{app}"; Flags: ignoreversion; Components: icons\gpu
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Types]
; only a custom type: no setup type dropdown, just the checklist below
Name: "custom"; Description: "Custom"; Flags: iscustom

[Components]
; "All icons" checks/unchecks every icon below it.
; Default ticks are set in [Code] (custom types can't pre-select components).
Name: "icons"; Description: "All icons"
Name: "icons\battery"; Description: "Battery Icon"
Name: "icons\cpu"; Description: "Cpu Icon"
Name: "icons\gpu"; Description: "Gpu Icon"
Name: "icons\ram"; Description: "Ram Icon"
Name: "icons\disk"; Description: "Disk Icon"
Name: "icons\net"; Description: "Net Icon"

[Icons]
Name: "{group}\BatteryIcon"; Filename: "{app}\BatteryIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\BatteryIcon.exe"; IconIndex: 0; Components: icons\battery
Name: "{group}\DiskIcon"; Filename: "{app}\DiskIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\DiskIcon.exe"; IconIndex: 0; Components: icons\disk
Name: "{group}\NetIcon"; Filename: "{app}\NetIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\NetIcon.exe"; IconIndex: 0; Components: icons\net
Name: "{group}\RamIcon"; Filename: "{app}\RamIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\RamIcon.exe"; IconIndex: 0; Components: icons\ram
Name: "{group}\CpuIcon"; Filename: "{app}\CpuIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\CpuIcon.exe"; IconIndex: 0; Components: icons\cpu
Name: "{group}\GpuIcon"; Filename: "{app}\GpuIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\GpuIcon.exe"; IconIndex: 0; Components: icons\gpu
Name: "{userstartup}\BatteryIcon"; Filename: "{app}\BatteryIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\BatteryIcon.exe"; IconIndex: 0; Components: icons\battery; Tasks: startup_battery
Name: "{userstartup}\DiskIcon"; Filename: "{app}\DiskIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\DiskIcon.exe"; IconIndex: 0; Components: icons\disk; Tasks: startup_disk
Name: "{userstartup}\NetIcon"; Filename: "{app}\NetIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\NetIcon.exe"; IconIndex: 0; Components: icons\net; Tasks: startup_net
Name: "{userstartup}\RamIcon"; Filename: "{app}\RamIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\RamIcon.exe"; IconIndex: 0; Components: icons\ram; Tasks: startup_ram
Name: "{userstartup}\CpuIcon"; Filename: "{app}\CpuIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\CpuIcon.exe"; IconIndex: 0; Components: icons\cpu; Tasks: startup_cpu
Name: "{userstartup}\GpuIcon"; Filename: "{app}\GpuIcon.exe"; WorkingDir: "{app}"; IconFilename: "{app}\GpuIcon.exe"; IconIndex: 0; Components: icons\gpu; Tasks: startup_gpu

[Tasks]
Name: "startup_battery"; Description: "Battery Icon"; GroupDescription: "Autostart on login"; Components: icons\battery
Name: "startup_cpu"; Description: "Cpu Icon"; GroupDescription: "Autostart on login"; Components: icons\cpu
Name: "startup_gpu"; Description: "Gpu Icon"; GroupDescription: "Autostart on login"; Components: icons\gpu
Name: "startup_ram"; Description: "Ram Icon"; GroupDescription: "Autostart on login"; Components: icons\ram
Name: "startup_disk"; Description: "Disk Icon"; GroupDescription: "Autostart on login"; Components: icons\disk
Name: "startup_net"; Description: "Net Icon"; GroupDescription: "Autostart on login"; Components: icons\net

[Run]
Filename: "{app}\BatteryIcon.exe"; WorkingDir: "{app}"; Flags: nowait postinstall; Description: "run Battery Icon"; Components: icons\battery
Filename: "{app}\CpuIcon.exe"; WorkingDir: "{app}"; Flags: nowait postinstall; Description: "run Cpu Icon"; Components: icons\cpu
Filename: "{app}\GpuIcon.exe"; WorkingDir: "{app}"; Flags: nowait postinstall; Description: "run Gpu Icon"; Components: icons\gpu
Filename: "{app}\RamIcon.exe"; WorkingDir: "{app}"; Flags: nowait postinstall; Description: "run Ram Icon"; Components: icons\ram
Filename: "{app}\DiskIcon.exe"; WorkingDir: "{app}"; Flags: nowait postinstall; Description: "run Disk Icon"; Components: icons\disk
Filename: "{app}\NetIcon.exe"; WorkingDir: "{app}"; Flags: nowait postinstall; Description: "run Net Icon"; Components: icons\net

[UninstallDelete]
; autostart shortcuts created later from an icon's right-click menu
Type: files; Name: "{userstartup}\BatteryIcon.lnk"
Type: files; Name: "{userstartup}\CpuIcon.lnk"
Type: files; Name: "{userstartup}\GpuIcon.lnk"
Type: files; Name: "{userstartup}\RamIcon.lnk"
Type: files; Name: "{userstartup}\DiskIcon.lnk"
Type: files; Name: "{userstartup}\NetIcon.lnk"
; portable-mode settings file, if one was created next to the icons
Type: files; Name: "{app}\settings.ini"

[Code]
const
  SettingsKey = 'SOFTWARE\strayge\TrayMonitor';

// Close running icons so their .exe files can be replaced or removed.
procedure CloseRunningIcons();
var
  Exe: String;
  Rest: String;
  P: Integer;
  ResultCode: Integer;
begin
  Rest := '{#AllIcons}' + ' ';
  while Length(Rest) > 0 do
  begin
    P := Pos(' ', Rest);
    Exe := Copy(Rest, 1, P - 1);
    Rest := Copy(Rest, P + 1, Length(Rest));
    if Exe <> '' then
      Exec(ExpandConstant('{sys}\taskkill.exe'), '/F /IM ' + Exe, '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  end;
  // give Windows a moment to release the files
  Sleep(500);
end;

function IsAnyComponentSelected(): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to WizardForm.ComponentsList.Items.Count - 1 do
    if WizardForm.ComponentsList.Checked[I] then
    begin
      Result := True;
      Exit;
    end;
end;

function NextButtonClick(PageID: Integer): Boolean;
begin
  Result:= True;
  if (PageID = wpSelectComponents) and not IsAnyComponentSelected() then begin
    MsgBox('No items selected, please select at least one item', mbError, MB_OK);
    Result := False;
  end;
end;

var
  ComponentsInitialized: Boolean;

// First visit of the components page: if nothing is ticked (fresh install,
// or upgrade from a version with different component names), tick all icons.
// A selection remembered from a previous install of this version is kept.
procedure CurPageChanged(CurPageID: Integer);
begin
  if (CurPageID = wpSelectComponents) and not ComponentsInitialized then
  begin
    ComponentsInitialized := True;
    if not IsAnyComponentSelected() then
      WizardSelectComponents('icons\battery,icons\cpu,icons\gpu,icons\ram,icons\disk,icons\net');
  end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  CloseRunningIcons();
  Result := '';
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  // after the user confirmed, before files are removed
  if CurUninstallStep = usUninstall then
    CloseRunningIcons();

  if (CurUninstallStep = usPostUninstall) and RegKeyExists(HKEY_CURRENT_USER, SettingsKey) then
  begin
    if UninstallSilent() then
      Exit;
    if MsgBox('Also remove your TrayMonitor settings (colors, intervals, etc.)?', mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
      RegDeleteKeyIncludingSubkeys(HKEY_CURRENT_USER, SettingsKey);
  end;
end;
